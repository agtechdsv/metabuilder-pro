{
  "name": "metabuilder-e2e",
  "private": true,
  "type": "module",
  "description": "Testes de ponta a ponta dos apps exportados pelo MetaBuilder PRO (Playwright)",
  "scripts": {
    "gen": "node scripts/generate.mjs",
    "seed": "node scripts/seed-postgres.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "record": "playwright codegen http://localhost:3101",
    "report": "playwright show-report",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "real:robot": "node scripts/create-robot.mjs",
    "real:prepare": "node scripts/prepare-real.mjs",
    "real:test": "playwright test -c playwright.real.config.ts",
    "real:ui": "playwright test -c playwright.real.config.ts --ui",
    "real:start": "npm run real:prepare && npm run real:ui",
    "real:run": "npm run real:prepare && npm run real:test",
    "real:robot:func": "node scripts/create-robot.mjs func",
    "real:robot:leitura": "node scripts/create-robot.mjs leitura"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "pg": "^8.13.0",
    "bcryptjs": "^2.4.3"
  }
}
