{
  "name": "metabuilder-e2e",
  "private": true,
  "type": "module",
  "description": "Testes de ponta a ponta dos apps exportados pelo MetaBuilder PRO (Playwright)",
  "scripts": {
    "gen": "node scripts/generate.mjs",
