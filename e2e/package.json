{
  "name": "metabuilder-e2e",
  "private": true,
  "type": "module",
  "description": "Testes de ponta a ponta dos apps exportados pelo MetaBuilder PRO (Playwright)",
  "scripts": {
    "gen": "node scripts/generate.mjs",
    "seed": "node scripts/seed-postgres.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "record": "playwright codegen http://localhost:3101",
    "report": "playwright show-report",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "real:robot": "node scripts/create-robot.mjs",
    "real:prepare": "node scripts/prepare-real.mjs",
    "real:test": "playwright test -c playwright.real.config.ts",
    "real:ui": "playwright test -c playwright.real.config.ts --ui",
    "real:start": "npm run real:prepare && npm run real:ui",
    "real:run": "npm run real:prepare && npm run real:test",
    "real:robot:func": "node scripts/create-robot.mjs func",
    "real:robot:leitura": "node scripts/create-robot.mjs leitura",
    "ora:robot": "node scripts/create-robot-oracle.mjs",
    "ora:robot:func": "node scripts/create-robot-oracle.mjs func",
    "ora:robot:leitura": "node scripts/create-robot-oracle.mjs leitura",
    "ora:prepare": "node scripts/prepare-real.mjs oracle",
    "ora:test": "playwright test -c playwright.oracle.config.ts",
    "ora:ui": "playwright test -c playwright.oracle.config.ts --ui",
    "ora:start": "npm run ora:prepare && npm run ora:ui",
    "ora:run": "npm run ora:prepare && npm run ora:test",
    "dyn:test": "playwright test -c playwright.dynamic.config.ts",
    "dyn:ui": "playwright test -c playwright.dynamic.config.ts --ui",
    "java:prepare": "node scripts/prepare-java.mjs",
    "java:test": "playwright test -c playwright.java.config.ts",
    "java:ui": "playwright test -c playwright.java.config.ts --ui",
    "java:start": "npm run java:prepare && npm run java:ui",
    "java:run": "npm run java:prepare && npm run java:test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "bcryptjs": "^2.4.3",
    "oracledb": "^6.10.0",
    "pg": "^8.13.0"
  }
}
