{
  "models": { "m_orders": "orders", "m_clients": "clients", "m_log": "audit_log" },
  "tables": {
    "clients": [{ "id": 7, "name": "Maria", "email": "maria@exemplo.com" }]
  },
  "cases": [
    {
      "name": "INSERT com condição verdadeira executa o UPDATE (PostgreSQL)",
      "dialect": "postgres",
      "flow": {
        "nodes": [
          { "id": "t", "type": "trigger", "data": { "triggerType": ["INSERT"], "triggerModelId": "m_orders" } },
          { "id": "c", "type": "condition", "data": { "conditionGroups": [{ "logic": "AND", "rules": [{ "field": "total", "operator": ">", "value": "100" }] }] } },
          { "id": "a", "type": "action", "data": { "actionType": "update", "actionModelId": "m_orders", "actionFilters": [{ "field": "id", "operator": "==", "value": "{{orders.id}}" }], "actionFields": [{ "field": "status", "value": "revisar" }] } }
        ],
        "edges": [
          { "source": "t", "target": "c" },
          { "source": "c", "target": "a", "sourceHandle": "true" }
        ]
      },
      "event": { "mode": "async", "table": "orders", "type": "INSERT", "row": { "id": 5, "total": 250 } },
      "expect": { "queries": [{ "sql": "UPDATE \"orders\" SET \"status\" = $1 WHERE \"id\" = $2", "params": ["revisar", "5"] }], "runs": [{ "status": "success", "source": "evento INSERT" }] }
    },
    {
      "name": "mesmo fluxo em Oracle usa :n",
      "dialect": "oracle",
      "flow": {
        "nodes": [
          { "id": "t", "type": "trigger", "data": { "triggerType": ["INSERT"], "triggerModelId": "m_orders" } },
          { "id": "a", "type": "action", "data": { "actionType": "update", "actionModelId": "m_orders", "actionFilters": [{ "field": "id", "operator": "==", "value": "{{orders.id}}" }], "actionFields": [{ "field": "status", "value": "revisar" }] } }
        ],
        "edges": [{ "source": "t", "target": "a" }]
      },
      "event": { "mode": "async", "table": "orders", "type": "INSERT", "row": { "id": 5, "total": 250 } },
      "expect": { "queries": [{ "sql": "UPDATE \"orders\" SET \"status\" = :1 WHERE \"id\" = :2", "params": ["revisar", "5"] }], "runs": [{ "status": "success" }] }
    },
    {
      "name": "condição falsa não executa nada",
      "dialect": "postgres",
      "flow": {
        "nodes": [
          { "id": "t", "type": "trigger", "data": { "triggerType": ["INSERT"], "triggerModelId": "m_orders" } },
          { "id": "c", "type": "condition", "data": { "conditionGroups": [{ "logic": "AND", "rules": [{ "field": "total", "operator": ">", "value": "100" }] }] } },
          { "id": "a", "type": "action", "data": { "actionType": "delete", "actionModelId": "m_orders", "actionFilters": [{ "field": "id", "operator": "==", "value": "{{orders.id}}" }] } }
        ],
        "edges": [
          { "source": "t", "target": "c" },
          { "source": "c", "target": "a", "sourceHandle": "true" }
        ]
      },
      "event": { "mode": "async", "table": "orders", "type": "INSERT", "row": { "id": 5, "total": 10 } },
      "expect": { "queries": [], "runs": [{ "status": "success" }] }
    },
    {
      "name": "UPDATE e DELETE sem filtro são ignorados (segurança)",
      "dialect": "postgres",
      "flow": {
        "nodes": [
          { "id": "t", "type": "trigger", "data": { "triggerType": ["UPDATE"], "triggerModelId": "m_orders" } },
          { "id": "a", "type": "action", "data": { "actionType": "update", "actionModelId": "m_orders", "actionFields": [{ "field": "status", "value": "x" }] } },
          { "id": "b", "type": "action", "data": { "actionType": "delete", "actionModelId": "m_orders" } }
        ],
        "edges": [{ "source": "t", "target": "a" }, { "source": "a", "target": "b" }]
      },
      "event": { "mode": "async", "table": "orders", "type": "UPDATE", "row": { "id": 1 } },
      "expect": { "queries": [], "runs": [{ "status": "success" }] }
    },
    {
      "name": "nome de campo malicioso é saneado (sem injeção)",
      "dialect": "postgres",
      "flow": {
        "nodes": [
          { "id": "t", "type": "trigger", "data": { "triggerType": ["INSERT"], "triggerModelId": "m_orders" } },
          { "id": "a", "type": "action", "data": { "actionType": "insert", "actionModelId": "m_log", "actionFields": [{ "field": "msg\"); DROP TABLE x;--", "value": "oi" }] } }
        ],
        "edges": [{ "source": "t", "target": "a" }]
      },
      "event": { "mode": "async", "table": "orders", "type": "INSERT", "row": { "id": 1 } },
      "expect": { "queries": [{ "sql": "INSERT INTO \"audit_log\" (\"msgDROPTABLEx\") VALUES ($1)", "params": ["oi"] }], "runs": [{ "status": "success" }] }
    },
    {
      "name": "variável de outra tabela busca pelo id da chave estrangeira (clients_id / client_id)",
      "dialect": "postgres",
      "flow": {
        "nodes": [
          { "id": "t", "type": "trigger", "data": { "triggerType": ["INSERT"], "triggerModelId": "m_orders" } },
          { "id": "a", "type": "action", "data": { "actionType": "insert", "actionModelId": "m_log", "actionFields": [{ "field": "msg", "value": "Pedido de {{clients.name}}" }] } }
        ],
        "edges": [{ "source": "t", "target": "a" }]
      },
      "event": { "mode": "async", "table": "orders", "type": "INSERT", "row": { "id": 1, "client_id": 7 } },
      "expect": { "queries": [{ "sql": "SELECT * FROM \"clients\" WHERE \"id\" = $1 LIMIT 1", "params": [7] }, { "sql": "INSERT INTO \"audit_log\" (\"msg\") VALUES ($1)", "params": ["Pedido de Maria"] }], "runs": [{ "status": "success" }] }
    },
    {
      "name": "tabela que não é modelo do projeto não é consultada",
      "dialect": "postgres",
      "flow": {
        "nodes": [
          { "id": "t", "type": "trigger", "data": { "triggerType": ["INSERT"], "triggerModelId": "m_orders" } },
          { "id": "a", "type": "action", "data": { "actionType": "insert", "actionModelId": "m_log", "actionFields": [{ "field": "msg", "value": "{{secrets.token}}" }] } }
        ],
        "edges": [{ "source": "t", "target": "a" }]
      },
      "event": { "mode": "async", "table": "orders", "type": "INSERT", "row": { "id": 1, "secret_id": 1 } },
      "expect": { "queries": [{ "sql": "INSERT INTO \"audit_log\" (\"msg\") VALUES ($1)", "params": ["{{secrets.token}}"] }], "runs": [{ "status": "success" }] }
    },
    {
      "name": "BEFORE_INSERT bloqueia com a mensagem do fluxo",
      "dialect": "postgres",
      "flow": {
        "nodes": [
          { "id": "t", "type": "trigger", "data": { "triggerType": ["BEFORE_INSERT"], "triggerModelId": "m_orders" } },
          { "id": "c", "type": "condition", "data": { "conditionGroups": [{ "logic": "AND", "rules": [{ "field": "total", "operator": "<=", "value": "0" }] }] } },
          { "id": "r", "type": "response", "data": { "responseAllowAction": false, "responseMessage": "Total {{orders.total}} inválido" } }
        ],
        "edges": [{ "source": "t", "target": "c" }, { "source": "c", "target": "r", "sourceHandle": "true" }]
      },
      "event": { "mode": "sync", "table": "orders", "type": "BEFORE_INSERT", "row": { "total": 0 } },
      "expect": { "sync": { "success": false, "error": "Total 0 inválido", "data": { "total": 0 } }, "queries": [], "runs": [{ "status": "success", "blocked": true }] }
    },
    {
      "name": "BEFORE_INSERT com condição falsa deixa passar",
      "dialect": "postgres",
      "flow": {
        "nodes": [
          { "id": "t", "type": "trigger", "data": { "triggerType": ["BEFORE_INSERT"], "triggerModelId": "m_orders" } },
          { "id": "c", "type": "condition", "data": { "conditionGroups": [{ "logic": "AND", "rules": [{ "field": "total", "operator": "<=", "value": "0" }] }] } },
          { "id": "r", "type": "response", "data": { "responseAllowAction": false, "responseMessage": "bloqueado" } }
        ],
        "edges": [{ "source": "t", "target": "c" }, { "source": "c", "target": "r", "sourceHandle": "true" }]
      },
      "event": { "mode": "sync", "table": "orders", "type": "BEFORE_INSERT", "row": { "total": 20 } },
      "expect": { "sync": { "success": true, "error": null, "data": { "total": 20 } }, "queries": [], "runs": [{ "status": "success", "blocked": false }] }
    },
    {
      "name": "BEFORE_UPDATE muda os dados em memória (mutate) e devolve mensagem",
      "dialect": "postgres",
      "flow": {
        "nodes": [
          { "id": "t", "type": "trigger", "data": { "triggerType": ["BEFORE_UPDATE"], "triggerModelId": "m_orders" } },
          { "id": "m", "type": "action", "data": { "actionType": "mutate", "actionFields": [{ "field": "status", "value": "analise" }] } },
          { "id": "r", "type": "response", "data": { "responseAllowAction": true, "responseMessage": "Enviado para análise" } }
        ],
        "edges": [{ "source": "t", "target": "m" }, { "source": "m", "target": "r" }]
      },
      "event": { "mode": "sync", "table": "orders", "type": "BEFORE_UPDATE", "row": { "id": 3, "status": "novo" } },
      "expect": { "sync": { "success": true, "message": "Enviado para análise", "data": { "id": 3, "status": "analise" } }, "queries": [] }
    },
