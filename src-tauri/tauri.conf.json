{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MetaBuilder PRO - IDE",
  "version": "1.1.11",
  "identifier": "com.metabuilder.pro",
  "build": {
    "frontendDist": "https://metabuilderpro.com",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MetaBuilder PRO - IDE",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "visible": false,
        "backgroundColor": "#F8F7FF"
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IG9sZF9rZXkKUldTNjBxZzZKNGxLT1ZnL3J5VWF2ZUorS1JKMTRBeTVzTkRUK3VJSXRkbjMrd3haUCs1Q0o2aTEK",
      "endpoints": [
        "https://chmstvtepzmjhpyxjjam.supabase.co/storage/v1/object/public/releases/ide/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "metabuilder"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/cli"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
