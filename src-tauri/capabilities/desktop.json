{
  "identifier": "desktop-capability",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://metabuilderpro.com",
      "https://metabuilderpro.com/**",
      "http://localhost:3000",
      "http://localhost:3000/**"
    ]
  },
  "permissions": [
    "updater:default",
    "opener:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "opener:allow-open-path",
    "fs:allow-download-read",
    "fs:allow-download-write"
  ]
}