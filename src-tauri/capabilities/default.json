{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://metabuilderpro.com",
      "http://localhost:3000"
    ]
  },
  "permissions": [
    "core:default",
    "shell:default",
    "deep-link:default",
    "fs:default",
    "fs:allow-applocaldata-read",
    "fs:allow-applocaldata-write",
    {
      "identifier": "shell:allow-open",
      "allow": [{ "url": "^https?://.*" }]
    }
  ]
}