{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "local": true,
  "windows": [
    "main",
    "splashscreen",
    "tunnel-logs",
    "*"
  ],
  "remote": {
    "urls": [
      "https://*.metabuilderpro.com",
      "https://*.metabuilderpro.com/*",
      "https://*.metabuilderpro.com/**",
      "https://metabuilderpro.com",
      "https://metabuilderpro.com/*",
      "https://metabuilderpro.com/**",
      "http://localhost:3000",
      "http://localhost:3000/*",
      "http://localhost:3000/**"
    ]
  },
  "permissions": [
    "core:default",
    "core:app:default",
    "core:app:allow-version",
    "core:path:default",
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "npm-run-dev",
          "cmd": "npm",
          "args": ["run", "dev"]
        },
        {
          "name": "cmd-npm-run-dev",
          "cmd": "cmd",
          "args": ["/c", "npm", "run", "dev"]
        },
        {
          "name": "powershell",
          "cmd": "powershell",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "npm",
          "cmd": "npm",
          "args": ["install"]
        },
        {
          "name": "npm-run-dev",
          "cmd": "npm",
          "args": ["run", "dev"]
        },
        {
          "name": "code",
          "cmd": "code",
          "args": ["."]
        },
        {
          "name": "cmd",
          "cmd": "cmd",
          "args": ["/c", "npm", "install"]
        },
        {
          "name": "cmd-npm-run-dev",
          "cmd": "cmd",
          "args": ["/c", "npm", "run", "dev"]
        },
        {
          "name": "powershell",
          "cmd": "powershell",
          "args": true
        }
      ]
    },
    "deep-link:default",
    "fs:default",
    "fs:allow-applocaldata-read",
    "fs:allow-applocaldata-read-recursive",
    "fs:allow-applocaldata-write",
    "fs:allow-applocaldata-write-recursive",
    "fs:allow-download-read",
    "fs:allow-download-write",
    "fs:allow-home-read",
    "fs:allow-home-write",
    {
      "identifier": "fs:scope",
      "allow": [
        "$HOME/**",
        "$HOME/**/*",
        "$APPLOCALDATA/**",
        "$APPLOCALDATA/**/*"
      ]
    },
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "opener:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "core:window:default",
    "core:window:allow-create",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "startcli",
    "stopcli",
    "start-nextjs-dev",
    "start-npm-install",
    "start-nextjs-server",
    "statuscli",
    "runsynccli",
    "openbrowser",
    "runinstaller",
    "core:window:allow-create",
    "spawn-pty",
    "write-pty",
    "resize-pty",
    "update-tray-menu",
    "open-devtools",
    "open-in-explorer",
    "check-node-available",
    "check-java-available",
    "start-spring-boot",
    "stop-spring-boot",
    "compile-java-workspace",
    "save-language",
    "get-saved-language"
  ]
}